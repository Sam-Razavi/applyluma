# ============================================
# ApplyLuma Frontend - Production Environment
# ============================================

# Backend API URL (replace with your Railway backend URL)
# Same-site API host: cookies set by api.applyluma.com are first-party for
# applyluma.com, so iOS/Safari do not block them as third-party (the raw
# *.up.railway.app host is a different site).
VITE_API_URL=https://api.applyluma.com

# Environment
VITE_ENVIRONMENT=production

